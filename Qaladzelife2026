<!DOCTYPE html>
<html lang="ku">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Qaladze Life</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:sans-serif;
}

body{
background:#0d0d0d;
color:white;
}

header{
background:black;
padding:15px 5%;
display:flex;
justify-content:space-between;
align-items:center;
border-bottom:2px solid red;
}

.logo{
font-size:32px;
font-weight:bold;
color:red;
}

nav a{
color:white;
text-decoration:none;
margin:0 15px;
}

nav a:hover{
color:red;
}

.hero{
height:90vh;
background:url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1600') center/cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
}

.hero-box{
background:rgba(0,0,0,0.6);
padding:40px;
border-radius:10px;
}

.hero h1{
font-size:60px;
margin-bottom:20px;
}

.hero p{
font-size:22px;
margin-bottom:20px;
}

.btn{
background:red;
padding:12px 30px;
color:white;
text-decoration:none;
border-radius:5px;
}

.section{
padding:60px 5%;
}

.title{
font-size:35px;
margin-bottom:30px;
border-left:5px solid red;
padding-left:15px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
background:#1a1a1a;
border-radius:10px;
overflow:hidden;
transition:0.3s;
}

.card:hover{
transform:translateY(-10px);
}

.card img{
width:100%;
height:200px;
object-fit:cover;
}

.card-content{
padding:20px;
}

footer{
background:black;
padding:30px;
text-align:center;
margin-top:50px;
border-top:2px solid red;
}

footer a{
color:white;
margin:0 10px;
text-decoration:none;
}

@media(max-width:768px){

.hero h1{
font-size:40px;
}

nav{
display:none;
}

}

</style>
</head>

<body>

<header>

<div class="logo">Qaladze Life</div>

<nav>
<a href="#">سەرەکی</a>
<a href="#">هەواڵ</a>
<a href="#">وەرزش</a>
<a href="#">ڤیدیۆ</a>
<a href="#">پەیوەندی</a>
</nav>

</header>

<section class="hero">

<div class="hero-box">
<h1>Qaladze Life</h1>
<p>نوێترین هەواڵ و ڕووداوەکان</p>

<a href="#" class="btn">
بینینی هەواڵەکان
</a>

</div>

</section>

<section class="section">

<h2 class="title">هەواڵە نوێکان</h2>

<div class="cards">

<div class="card">
<img src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?q=80&w=1200">

<div class="card-content">
<h3>هەواڵی سیاسی</h3>
<p>دوایین هەواڵە سیاسیەکان</p>
</div>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=1200">

<div class="card-content">
<h3>وەرزش</h3>
<p>دوایین هەواڵی تۆپی پێ</p>
</div>

</div>

<div class="card">

<img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200">

<div class="card-content">
<h3>تەکنەلۆجیا</h3>
<p>نوێترین زانیاری AI و تەکنەلۆجیا</p>
</div>

</div>

</div>

</section>

<footer>

<h2>Qaladze Life</h2>

<p>© 2026 All Rights Reserved</p>

<br>

<a href="#">Facebook</a>
<a href="#">Instagram</a>
<a href="#">TikTok</a>
<a href="#">YouTube</a>

</footer>

</body>
</html>
